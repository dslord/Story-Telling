rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. USERS PROFILE
    match /users/{userId} {
      // Only the user themselves can read their own profile
      allow read: if request.auth != null && request.auth.uid == userId;

      // Only the user themselves can create their own profile, initializing totalLikesReceived to 0 or omitting it
      allow create: if request.auth != null && request.auth.uid == userId
        && (!('totalLikesReceived' in request.resource.data) || request.resource.data.totalLikesReceived == 0);

      // Updates are split into two cases:
      // Case A: Owner editing profile fields (must not modify totalLikesReceived)
      // Case B: Anyone liking/unliking (controlled transaction modifying ONLY totalLikesReceived by exactly +1 or -1)
      allow update: if request.auth != null && (
        (
          request.auth.uid == userId
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['totalLikesReceived'])
        )
        ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['totalLikesReceived'])
          && (
            // Increment
            (
              (
                'totalLikesReceived' in resource.data
                && request.resource.data.totalLikesReceived == resource.data.totalLikesReceived + 1
              )
              ||
              (
                !('totalLikesReceived' in resource.data)
                && request.resource.data.totalLikesReceived == 1
              )
            )
            ||
            // Decrement
            (
              (
                'totalLikesReceived' in resource.data
                && request.resource.data.totalLikesReceived == resource.data.totalLikesReceived - 1
                && request.resource.data.totalLikesReceived >= 0
              )
              ||
              (
                !('totalLikesReceived' in resource.data)
                && request.resource.data.totalLikesReceived == 0
              )
            )
          )
        )
      );

      // Only the user themselves can delete their profile
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // 2. STORIES
    match /stories/{storyId} {
      // Anyone (even unauthenticated) can read public stories
      allow read: if true;

      // Only authenticated users can delete their own stories
      allow delete: if request.auth != null && resource.data.authorUid == request.auth.uid;

      // Authenticated users can create stories for themselves
      allow create: if request.auth != null
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.likesCount == 0
        && request.resource.data.commentsCount == 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 200
        && request.resource.data.description is string && request.resource.data.description.size() > 0 && request.resource.data.description.size() <= 1000
        && request.resource.data.story is string && request.resource.data.story.size() > 0 && request.resource.data.story.size() <= 50000
        && request.resource.data.moral is string && request.resource.data.moral.size() > 0 && request.resource.data.moral.size() <= 500
        && request.resource.data.authorName is string && request.resource.data.authorName.size() > 0
        && request.resource.data.keys().hasOnly([
          'title', 'description', 'story', 'moral', 'authorUid', 'authorName', 'likesCount', 'commentsCount', 'createdAt'
        ]);

      // Story updates: split into three permitted cases (content edit by owner, likes, or commentsCount continuation)
      allow update: if request.auth != null && (
        // Case A: Owner editing story content fields
        (
          resource.data.authorUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'description', 'story', 'moral'])
          && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 200
          && request.resource.data.description is string && request.resource.data.description.size() > 0 && request.resource.data.description.size() <= 1000
          && request.resource.data.story is string && request.resource.data.story.size() > 0 && request.resource.data.story.size() <= 50000
          && request.resource.data.moral is string && request.resource.data.moral.size() > 0 && request.resource.data.moral.size() <= 500
        )
        ||
        // Case B: Liking/Unliking by an authenticated user (verifying both story likesCount and author's totalLikesReceived)
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount'])
          && (
            // Like (increment by 1)
            (
              request.resource.data.likesCount == resource.data.likesCount + 1
              && existsAfter(/databases/$(database)/documents/stories/$(storyId)/likes/$(request.auth.uid))
              && !exists(/databases/$(database)/documents/stories/$(storyId)/likes/$(request.auth.uid))
              && (
                (
                  'totalLikesReceived' in get(/databases/$(database)/documents/users/$(resource.data.authorUid)).data
                  && getAfter(/databases/$(database)/documents/users/$(resource.data.authorUid)).data.totalLikesReceived == get(/databases/$(database)/documents/users/$(resource.data.authorUid)).data.totalLikesReceived + 1
                )
                ||
                (
                  !('totalLikesReceived' in get(/databases/$(database)/documents/users/$(resource.data.authorUid)).data)
                  && getAfter(/databases/$(database)/documents/users/$(resource.data.authorUid)).data.totalLikesReceived == 1
                )
              )
            )
            ||
            // Unlike (decrement by 1, cannot go below 0)
            (
              request.resource.data.likesCount == resource.data.likesCount - 1
              && request.resource.data.likesCount >= 0
              && !existsAfter(/databases/$(database)/documents/stories/$(storyId)/likes/$(request.auth.uid))
              && exists(/databases/$(database)/documents/stories/$(storyId)/likes/$(request.auth.uid))
              && (
                (
                  'totalLikesReceived' in get(/databases/$(database)/documents/users/$(resource.data.authorUid)).data
                  && getAfter(/databases/$(database)/documents/users/$(resource.data.authorUid)).data.totalLikesReceived == get(/databases/$(database)/documents/users/$(resource.data.authorUid)).data.totalLikesReceived - 1
                  && getAfter(/databases/$(database)/documents/users/$(resource.data.authorUid)).data.totalLikesReceived >= 0
                )
                ||
                (
                  !('totalLikesReceived' in get(/databases/$(database)/documents/users/$(resource.data.authorUid)).data)
                  && getAfter(/databases/$(database)/documents/users/$(resource.data.authorUid)).data.totalLikesReceived == 0
                )
              )
            )
          )
        )
        ||
        // Case C: Comment create/delete by an authenticated user, incrementing/decrementing commentsCount by exactly 1.
        // The exact doc-level pairing is validated in the comment document rules, while story updates remain limited to ±1 and non-negative values.
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentsCount'])
          && (
            (
              (
                'commentsCount' in resource.data
                && request.resource.data.commentsCount == resource.data.commentsCount + 1
                && request.resource.data.commentsCount >= 0
              )
              ||
              (
                !('commentsCount' in resource.data)
                && request.resource.data.commentsCount == 1
              )
            )
            ||
            (
              (
                'commentsCount' in resource.data
                && request.resource.data.commentsCount == resource.data.commentsCount - 1
                && request.resource.data.commentsCount >= 0
              )
              ||
              (
                !('commentsCount' in resource.data)
                && request.resource.data.commentsCount == 0
              )
            )
          )
        )
      );
    }

    // 3. STORY LIKES
    match /stories/{storyId}/likes/{userId} {
      // Authenticated users can read like documents (needed for like status checks)
      allow read: if request.auth != null;

      // Only the user themselves can create their like document, requiring parent story's likesCount and author's totalLikesReceived to increment by 1
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.likedAt == request.time
        && request.resource.data.keys().hasOnly(['likedAt'])
        && getAfter(/databases/$(database)/documents/stories/$(storyId)).data.likesCount == get(/databases/$(database)/documents/stories/$(storyId)).data.likesCount + 1
        && (
          (
            'totalLikesReceived' in get(/databases/$(database)/documents/users/$(get(/databases/$(database)/documents/stories/$(storyId)).data.authorUid)).data
            && getAfter(/databases/$(database)/documents/users/$(get(/databases/$(database)/documents/stories/$(storyId)).data.authorUid)).data.totalLikesReceived == get(/databases/$(database)/documents/users/$(get(/databases/$(database)/documents/stories/$(storyId)).data.authorUid)).data.totalLikesReceived + 1
          )
          ||
          (
            !('totalLikesReceived' in get(/databases/$(database)/documents/users/$(get(/databases/$(database)/documents/stories/$(storyId)).data.authorUid)).data)
            && getAfter(/databases/$(database)/documents/users/$(get(/databases/$(database)/documents/stories/$(storyId)).data.authorUid)).data.totalLikesReceived == 1
          )
        );

      // Deleting a like document requires parent story's likesCount and author's totalLikesReceived to decrement by 1,
      // OR the story owner to delete the like document when deleting the story itself.
      allow delete: if request.auth != null && (
        (
          request.auth.uid == userId
          && getAfter(/databases/$(database)/documents/stories/$(storyId)).data.likesCount == get(/databases/$(database)/documents/stories/$(storyId)).data.likesCount - 1
          && (
            (
              'totalLikesReceived' in get(/databases/$(database)/documents/users/$(get(/databases/$(database)/documents/stories/$(storyId)).data.authorUid)).data
              && getAfter(/databases/$(database)/documents/users/$(get(/databases/$(database)/documents/stories/$(storyId)).data.authorUid)).data.totalLikesReceived == get(/databases/$(database)/documents/users/$(get(/databases/$(database)/documents/stories/$(storyId)).data.authorUid)).data.totalLikesReceived - 1
              && getAfter(/databases/$(database)/documents/users/$(get(/databases/$(database)/documents/stories/$(storyId)).data.authorUid)).data.totalLikesReceived >= 0
            )
            ||
            (
              !('totalLikesReceived' in get(/databases/$(database)/documents/users/$(get(/databases/$(database)/documents/stories/$(storyId)).data.authorUid)).data)
              && getAfter(/databases/$(database)/documents/users/$(get(/databases/$(database)/documents/stories/$(storyId)).data.authorUid)).data.totalLikesReceived == 0
            )
          )
        )
        ||
        (
          get(/databases/$(database)/documents/stories/$(storyId)).data.authorUid == request.auth.uid
          && !existsAfter(/databases/$(database)/documents/stories/$(storyId))
        )
      );
    }

    // 4. STORY COMMENTS
    match /stories/{storyId}/comments/{commentId} {
      // Authenticated users can read comments
      allow read: if request.auth != null;

      // Authenticated users can create comments, and the parent story's commentsCount must increment by exactly 1 in the same transaction.
      allow create: if request.auth != null
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.storyId == storyId
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1000
        && request.resource.data.createdAt == request.time
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() > 0
        && request.resource.data.keys().hasOnly(['storyId', 'authorUid', 'authorName', 'text', 'createdAt'])
        && exists(/databases/$(database)/documents/stories/$(storyId))
        && (
          (
            'commentsCount' in get(/databases/$(database)/documents/stories/$(storyId)).data
            && getAfter(/databases/$(database)/documents/stories/$(storyId)).data.commentsCount == get(/databases/$(database)/documents/stories/$(storyId)).data.commentsCount + 1
          )
          ||
          (
            !('commentsCount' in get(/databases/$(database)/documents/stories/$(storyId)).data)
            && getAfter(/databases/$(database)/documents/stories/$(storyId)).data.commentsCount == 1
          )
        )
        && getAfter(/databases/$(database)/documents/stories/$(storyId)).data.commentsCount >= 0;

      // Comment author or parent story owner can delete. For legacy stories that do not yet have commentsCount, deletion is allowed when the count is absent or resets to 0.
      allow delete: if request.auth != null && (
        (
          resource.data.authorUid == request.auth.uid
          && (
            !exists(/databases/$(database)/documents/stories/$(storyId))
            || (
              exists(/databases/$(database)/documents/stories/$(storyId))
              && (
                (
                  'commentsCount' in get(/databases/$(database)/documents/stories/$(storyId)).data
                  && getAfter(/databases/$(database)/documents/stories/$(storyId)).data.commentsCount == get(/databases/$(database)/documents/stories/$(storyId)).data.commentsCount - 1
                  && getAfter(/databases/$(database)/documents/stories/$(storyId)).data.commentsCount >= 0
                )
                ||
                (
                  !('commentsCount' in get(/databases/$(database)/documents/stories/$(storyId)).data)
                  && (!('commentsCount' in getAfter(/databases/$(database)/documents/stories/$(storyId)).data) || getAfter(/databases/$(database)/documents/stories/$(storyId)).data.commentsCount == 0)
                )
              )
            )
          )
        )
        ||
        (
          exists(/databases/$(database)/documents/stories/$(storyId))
          && get(/databases/$(database)/documents/stories/$(storyId)).data.authorUid == request.auth.uid
          && (
            (
              'commentsCount' in get(/databases/$(database)/documents/stories/$(storyId)).data
              && getAfter(/databases/$(database)/documents/stories/$(storyId)).data.commentsCount == get(/databases/$(database)/documents/stories/$(storyId)).data.commentsCount - 1
              && getAfter(/databases/$(database)/documents/stories/$(storyId)).data.commentsCount >= 0
            )
            ||
            (
              !('commentsCount' in get(/databases/$(database)/documents/stories/$(storyId)).data)
              && (!('commentsCount' in getAfter(/databases/$(database)/documents/stories/$(storyId)).data) || getAfter(/databases/$(database)/documents/stories/$(storyId)).data.commentsCount == 0)
            )
          )
        )
      );

      // Comments cannot be updated
      allow update: if false;
    }
  }
}
